# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI agent (needed from feat/split-engine) ---
ANTHROPIC_API_KEY=
# Set to false to skip the AI and use the plain algorithm only
AI_ENABLED=true

# --- Rate limiting (needed before the API goes public) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Database (needed for share links) ---
DATABASE_URL=
# Direct connection for migrations, if your host uses a pooled URL
DIRECT_URL=

# --- Auth, optional sign-in for saving squads (later) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Monitoring (later) ---
SENTRY_DSN=